#Configuration file for swot - gg lensing example
#----------------------------------------------------------#
#Input catalogues                                          #
#----------------------------------------------------------#
data1          catalogs/Matched/fore_gal_swot.txt
cols1          1,2,3,4	        # Column ids for data1
data2          catalogs/Shape/bg_gal_flip_g1.txt
cols2          1,2,3,4,5,6,7    # Column ids for data2
#----------------------------------------------------------#
#Correlation options                                       #
#----------------------------------------------------------#
corr           gglens	 # Type of correlation: [auto,cross,gglens,auto_wp,cross_wp]
range          1,30
nbins          15	 # Number of bins
log            yes	 # Logarithmic bins [yes,no]
err            jackknife # Resampling method [bootstrap,jackknife]
nsamples       32	 # Number of samples for resampling (power of 2)
OA             0.05	 # Open angle for approximation (value or "no") 
#----------------------------------------------------------#
#Cosmology (for gal-gal correlations, w(R) and xi(rp,PI))  #
#----------------------------------------------------------#
H0             70	 # Hubble parameter
Omega_M        0.3	 # Relative matter density
Omega_L        0.7	 # Relative energy density (Lambda)
deltaz         0.03	 # For gg lensing: Zsource > Zlens + deltaz
#----------------------------------------------------------#
#Output options                                            #
#----------------------------------------------------------#
proj           como	 # Axis projection [theta, como, phys:
                    	 # auto, cross: default: theta (deg)
                    	 # auto_wp, cross_wp, gglens: default: como (Mpc)
out            results/mock/ggl.out
cov            no	 # Covariance matrix of errors [yes,no] (in "out".cov)
